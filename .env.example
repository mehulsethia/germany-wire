# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
# Optional: override model (default claude-haiku-4-5-20251001, cheap + fast)
ANTHROPIC_MODEL=

# Bundestag DIP API key (https://dip.bundestag.de/documents/informationsblatt_zur_dip_api_v01.pdf). Source skipped if empty.
DIP_API_KEY=

# Protects /api/cron/ingest. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Optional tuning
RELEVANCE_THRESHOLD=40
MAX_NEW_PER_RUN=40
