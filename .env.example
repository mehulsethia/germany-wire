# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM keys. If both are set they are used turn by turn (and cover for each other on errors).
OPENAI_API_KEY=
# Optional: default gpt-4.1-mini
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Optional: default claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Bundestag DIP API key (free, request at https://dip.bundestag.de/%C3%BCber-dip/hilfe/api). Source skipped if empty.
DIP_API_KEY=

# Protects /api/cron/ingest. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Optional tuning
RELEVANCE_THRESHOLD=35
MAX_NEW_PER_RUN=60
